# Copy to .env for local development (`npm run dev`). On Vercel, add the same names under
# Project → Settings → Environment Variables instead. Never commit a real .env file.

# --- Supabase (required for the hosted version) -------------------------------------------
# Supabase dashboard → Project Settings → API (or "Connect"): Project URL and the anon / publishable key.
# These two are safe to expose in the browser: row level security protects the data.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# --- AI assistant (optional, server side only: never prefix these with VITE_) --------------
# Set ONE of these. Without any, the assistant still works using built-in commands
# ("add …", "move … to Done", "assign … to …").
# Google Gemini has a free tier: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GROQ_API_KEY=            # free tier: https://console.groq.com/keys
# ANTHROPIC_API_KEY=       # Claude: https://console.anthropic.com
# OPENAI_API_KEY=
# AI_API_KEY= / AI_BASE_URL=   # any other OpenAI-compatible endpoint (OpenRouter, Ollama, ...)
# AI_MODEL=                # optional: override the default model for the chosen provider
